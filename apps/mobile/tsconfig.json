{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "paths": {
      "@eu/core": ["../../packages/core/src/index.ts"],
      "@eu/core/*": ["../../packages/core/src/*"],
      "@eu/sync/client": ["../../packages/sync/src/client.ts"],
      "@eu/sync/sql-store": ["../../packages/sync/src/sql-store.ts"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx"]
}
