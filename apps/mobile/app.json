{
  "expo": {
    "name": "GoCongo",
    "slug": "gocongo-eu",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "cd.gocongo.eu",
      "versionCode": 1,
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-secure-store",
      "expo-localization",
      ["expo-image-picker", { "cameraPermission": "GoCongo uses the camera to take evidence photos." }],
      ["expo-location", { "locationWhenInUsePermission": "GoCongo records where evidence photos are taken." }]
    ],
    "extra": {
      "apiBase": "https://eu2-roan.vercel.app"
    }
  }
}
