{
  "expo": {
    "name": "GoCongo",
    "slug": "gocongo-eu",
    "version": "0.7.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "cd.gocongo.eu",
      "versionCode": 8,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C6B33"
      }
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InterTight_400Regular.ttf",
            "./assets/fonts/InterTight_600SemiBold.ttf",
            "./assets/fonts/InterTight_700Bold.ttf",
            "./assets/fonts/InterTight_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "GoCongo uses the camera to take evidence photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GoCongo uses your location to find the plot or borehole you are at and to stamp records and photos with GPS."
        }
      ]
    ],
    "extra": {
      "apiBase": "https://eu2-roan.vercel.app",
      "eas": {
        "projectId": "3360412d-5e27-4140-abf3-d3335d34f729"
      }
    },
    "owner": "roshangocongos-team",
    "icon": "./assets/icon.png",
    "backgroundColor": "#1C6B33"
  }
}
